        "message": "=<div style=\"background:#f4f5f7;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;\"><tr><td style=\"background:#B91C1C;padding:24px 32px;color:#ffffff;\"><div style=\"font-size:12px;letter-spacing:1px;text-transform:uppercase;opacity:.85;\">Critical workflow error</div><div style=\"font-size:22px;font-weight:bold;margin-top:6px;\">{{ $('Check Throttle').first().json.workflow }} failed</div></td></tr><tr><td style=\"padding:26px 32px;color:#1f2937;font-size:15px;line-height:1.6;\"><p><b>Workflow:</b> {{ $('Check Throttle').first().json.workflow }}<br><b>Failed node:</b> {{ $('Check Throttle').first().json.node }}<br><b>Type:</b> {{ $('Check Throttle').first().json.type }} &middot; <b>Severity:</b> {{ $('Check Throttle').first().json.severity }}<br><b>Time:</b> {{ $('Check Throttle').first().json.time }}</p><p><b>Error:</b> {{ $('Check Throttle').first().json.message }}</p><p style=\"background:#FEF3C7;padding:12px;border-radius:8px;\"><b>What to do:</b> {{ $('Check Throttle').first().json.fix }}</p>{{ $('Check Throttle').first().json.executionUrl ? '<p><a href=\"' + $('Check Throttle').first().json.executionUrl + '\" style=\"background:#B91C1C;color:#ffffff;padding:10px 18px;border-radius:8px;text-decoration:none;\">Open the failed execution</a></p>' : '' }}<p style=\"color:#6b7280;font-size:13px;\">Repeats of this problem in the next 60 minutes are logged but not emailed. When fixed, set its Status to <b>resolved</b> in the Error Log sheet.</p></td></tr><tr><td style=\"padding:14px 32px;background:#f9fafb;color:#9ca3af;font-size:12px;text-align:center;\">Horizon Byte Solutions &middot; Automation Monitoring</td></tr></table></div>",
