    {
      "parameters": {
        "sendTo": "={{ $('Validate Evaluation').first().json.email }}",
        "subject": "=Next step: interview for {{ $('Validate Evaluation').first().json.position }}",
        "message": "=<div style=\"background:#f4f5f7;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;\"><tr><td style=\"background:#2563EB;padding:24px 32px;color:#ffffff;\"><div style=\"font-size:12px;letter-spacing:1px;text-transform:uppercase;opacity:.85;\">Your application</div><div style=\"font-size:22px;font-weight:bold;margin-top:6px;\">We'd like to meet you!</div></td></tr><tr><td style=\"padding:26px 32px;color:#1f2937;font-size:15px;line-height:1.6;\"><p>Hi {{ $('Validate Evaluation').first().json.name.split(' ')[0] }},</p><p>Thank you for applying for the <b>{{ $('Validate Evaluation').first().json.position }}</b> role. Your profile stood out to our team, and we would like to invite you to a 30-minute online interview.</p><p>Please reply to this email with <b>three time slots</b> that suit you during the next 5 working days.</p><p>We look forward to speaking with you.</p><p>Best regards,<br><b>Talent Acquisition Team</b></p></td></tr><tr><td style=\"padding:14px 32px;background:#f9fafb;color:#9ca3af;font-size:12px;text-align:center;\">Horizon Byte Solutions &middot; Talent Acquisition</td></tr></table></div>",
        "options": {
          "appendAttribution": false
        }
      },
