    {
      "parameters": {
        "text": "={{ $json.cvText }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"years_experience\": {\n      \"type\": \"number\",\n      \"description\": \"Total years of professional work experience, internships count as 0.5\"\n    },\n    \"education\": {\n      \"type\": \"string\",\n      \"description\": \"Highest degree, field and university\"\n    },\n    \"current_or_last_role\": {\n      \"type\": \"string\"\n    },\n    \"skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Skills exactly as written in the CV\"\n    },\n    \"languages\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"certifications\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"years_experience\",\n    \"education\",\n    \"skills\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You extract facts from CVs. Only extract information that is written in the CV text. Never guess or add skills that are not mentioned."
        }
      },
      "id": "cab83442-460d-4a09-9979-9a09a61889b4",
